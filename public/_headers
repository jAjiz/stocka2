# Cabeceras de Cloudflare static assets (spec §9). No se sirve como archivo.
# Si varias reglas coinciden, Cloudflare junta sus cabeceras: «! Cache-Control» quita la de
# una regla anterior.

# Los .js y .css del build llevan hash en el nombre.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Lo que decide qué versión ve el usuario no se guarda en caché del navegador.
/index.html
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/ngsw-worker.js
  ! Cache-Control
  Cache-Control: no-cache
/safety-worker.js
  ! Cache-Control
  Cache-Control: no-cache
/worker-basic.min.js
  ! Cache-Control
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
